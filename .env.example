# Sievax Academy — secrets. Kopieer naar .env OP DE SERVER (chmod 600).
# NOOIT committen, nooit op een gedeelde Drive.
# Laat BREVO_API_KEY op "dry" om lokaal te testen: dan wordt er niet gemaild
# maar gelogd in storage/leads.log.

BREVO_API_KEY=dry
BREVO_SENDER_NAME=Sievax Academy
BREVO_SENDER_EMAIL=jan@sievax.be
NOTIFY_EMAIL=jan@sievax.be
